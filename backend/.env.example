# ---- Server ----
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/devflow?schema=public"

# ---- Auth ----
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-15). 12 is a good default for 2026 hardware.
BCRYPT_SALT_ROUNDS=12
